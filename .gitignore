# Local scratch drafts — never committed or pushed
草稿.md

# Local Claude Code config (hooks, settings) — personal, never committed
.claude/

# Node
node_modules/
dist/

# mastic 自己跑出来的运行产物(任务书 / 交付报告 / 事件流)
# 想留证据给前端看的时候用 `mastic ui --run <id>`,不必进 git。
.mastic/*
# 但技能和 MCP 配置是**配置**,该跟着仓库走
!.mastic/skills
!.mastic/mcp.json

# Secrets — the API key lives in .env, never commit it (.env.example is the template)
.env
.env.*
!.env.example

# npm pack 出来的包
*.tgz
