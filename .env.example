# ─────────────────────────────────────────────────────────────
#  OpenAI 格式接口配置
#
#  任何兼容 POST /chat/completions 的服务都能直接用,改下面三项即可。
#  用法:复制成 .env 再填 key ——  cp .env.example .env
#  .env 已被 .gitignore 忽略,不会进 git。
# ─────────────────────────────────────────────────────────────

# 必填:API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接口地址。默认 DeepSeek:
#   DeepSeek      https://api.deepseek.com/v1
#   OpenAI        https://api.openai.com/v1
#   本地 Ollama   http://localhost:11434/v1
#   月之暗面       https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名。DeepSeek 常用:
#   deepseek-chat      V3,通用对话
#   deepseek-reasoner  R1,带思维链的推理模型
OPENAI_MODEL=deepseek-chat

# 可选:系统提示词,留空则用默认
SYSTEM_PROMPT=You are a helpful assistant.

# ── 上下文压缩 ─────────────────────────────────────────────
# 平时不干预,上下文一直攒;涨到 COMPACT_AT 就压一次:
#   人设原样保留 → 最近的 KEEP_RECENT 原样保留 → 更早的全部折叠成一份摘要。
# 两个数按你所用模型的窗口定(如 128K 窗口取 COMPACT_AT 略低于它),
# 且必须满足 KEEP_RECENT < COMPACT_AT,否则压完立刻又满。
COMPACT_AT=120000
KEEP_RECENT=40000
