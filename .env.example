# ─────────────────────────────────────────────────────────────
#  OpenAI 格式接口配置
#
#  任何兼容 POST /chat/completions 的服务都能直接用,改下面三项即可。
#  用法:复制成 .env 再填 key ——  cp .env.example .env
#  .env 已被 .gitignore 忽略,不会进 git。
# ─────────────────────────────────────────────────────────────

# 必填:API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接口地址。默认 DeepSeek:
#   DeepSeek      https://api.deepseek.com/v1
#   OpenAI        https://api.openai.com/v1
#   本地 Ollama   http://localhost:11434/v1
#   月之暗面       https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名。DeepSeek 常用:
#   deepseek-chat      V3,通用对话
#   deepseek-reasoner  R1,带思维链的推理模型
OPENAI_MODEL=deepseek-chat

# ── 编排 ───────────────────────────────────────────────────
# agent 动手的目录。任务书里的相对路径、验收命令的 cwd 都相对它。
# 不填则用当前目录。
# MASTIC_WORKSPACE=/path/to/repo

# 同时跑几个 worker。任务树里互不依赖的节点按这个上限并行。
MASTIC_CONCURRENCY=3

# 被 verifier 判 contradicted 之后,最多把任务重派几次;
# 超了落 blocked 并写明卡在哪 —— 不会退化成谎报成功。
MASTIC_MAX_RETRIES=2

# ── 步数预算 ───────────────────────────────────────────────
# 这些是**机器的数**,不是模型报的数。
#
# 原先每份任务书里有个 max_steps,由 planner 拍脑袋写。那个数没有刻度:
# 它这次的"30"和下次的"30"对应的难度不是一个东西,而不可比的数不能用来
# 分配资源。现在分配规则是固定的算式,参数在这儿:
#
#   每个任务的上限 = min(硬顶, 剩余预算 ÷ 还没开始的任务数)

# 整次运行的工具往返总预算。用掉多少扣多少。
MASTIC_RUN_BUDGET_STEPS=400

# 单个任务的硬顶 —— 防止某个任务一次把总预算吃光。
MASTIC_TASK_STEP_CEILING=80

# planner 最多几步。只有一个 planner,不存在分配问题。
MASTIC_PLANNER_STEPS=40

# 跑验收命令 / 重放证据的超时(毫秒)。
MASTIC_COMMAND_TIMEOUT_MS=300000

# 模型流多久没有新内容就判连接死了(毫秒)。
# 是空闲超时不是总时长超时 —— 长回答本来就该慢慢吐。
MASTIC_REQUEST_IDLE_TIMEOUT_MS=240000

# 模型收不收图片。设成 0 时,界面上不会出现上传入口,
# 免得点了必然失败。默认开着。
MASTIC_VISION=1

# ── 联网取数 ───────────────────────────────────────────────
# web_search 用的 Tavily key。没有它搜索会明确报错(fetch_url 不用它)。
# 也认标准的 TAVILY_API_KEY。
# 申请:https://tavily.com
# 值留空 —— 别在这里写形如 tvly-xxx 的占位符,
# 密钥扫描器会把它当成疑似泄露的 key 报上去。
MASTIC_TAVILY_API_KEY=
