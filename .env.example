# ─────────────────────────────────────────────────────────────
#  OpenAI 格式接口配置
#
#  任何兼容 POST /chat/completions 的服务都能直接用,改下面三项即可。
#  用法:复制成 .env 再填 key ——  cp .env.example .env
#  .env 已被 .gitignore 忽略,不会进 git。
# ─────────────────────────────────────────────────────────────

# 必填:API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 接口地址。默认 DeepSeek:
#   DeepSeek      https://api.deepseek.com/v1
#   OpenAI        https://api.openai.com/v1
#   本地 Ollama   http://localhost:11434/v1
#   月之暗面       https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名。DeepSeek 常用:
#   deepseek-chat      V3,通用对话
#   deepseek-reasoner  R1,带思维链的推理模型
OPENAI_MODEL=deepseek-chat

# ── 编排 ───────────────────────────────────────────────────
# agent 动手的目录。任务书里的相对路径、验收命令的 cwd 都相对它。
# 不填则用当前目录。
# MASTIC_WORKSPACE=/path/to/repo

# 同时跑几个 worker。任务树里互不依赖的节点按这个上限并行。
MASTIC_CONCURRENCY=3

# 被 verifier 判 contradicted 之后,最多把任务重派几次;
# 超了落 blocked 并写明卡在哪 —— 不会退化成谎报成功。
MASTIC_MAX_RETRIES=2

# 单个 worker 一轮最多几次工具往返。
MASTIC_MAX_STEPS=30

# 跑验收命令 / 重放证据的超时(毫秒)。
MASTIC_COMMAND_TIMEOUT_MS=300000

# 模型流多久没有新内容就判连接死了(毫秒)。
# 是空闲超时不是总时长超时 —— 长回答本来就该慢慢吐。
MASTIC_REQUEST_IDLE_TIMEOUT_MS=120000

# 模型收不收图片。设成 0 时,界面上不会出现上传入口,
# 免得点了必然失败。默认开着。
MASTIC_VISION=1
